{
  "name": "swiftmailer/swiftmailer",
  "type": "library",
  "description": "Swiftmailer, free feature-rich PHP mailer -- maintained by Redrock Software Corporation with Symfony Mailer features back-ported for legacy and enterprise applications",
  "keywords": [
    "mail",
    "mailer",
    "email",
    "smtp",
    "api"
  ],
  "homepage": "https://www.go-redrock.com/",
  "license": "MIT",
  "authors": [
    {
      "name": "Chris Corbyn"
    },
    {
      "name": "Fabien Potencier",
      "email": "fabien@symfony.com"
    },
    {
      "name": "Redrock Software Corporation",
      "homepage": "https://www.go-redrock.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "ext-intl": "*",
    "ext-openssl": "*",
    "egulias/email-validator": "^2.0|^3.1|^4.0.2",
    "phpseclib/phpseclib": "^3.0.52",
    "nyholm/dsn": "2.*",
    "google/apiclient": "^2.16",
    "microsoft/microsoft-graph": "^2.10",
    "stevenmaguire/oauth2-microsoft": "^2.2",
    "league/oauth2-client": "^2.7",
    "league/oauth2-google": "^4.0",
    "async-aws/ses": "^1.8",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.0",
    "symfony/phpunit-bridge": "^4.4|^5.4",
    "phpunit/phpunit": "^9.6.33",
    "friendsofphp/php-cs-fixer": "^3.57",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.0",
    "roave/security-advisories": "dev-master",
    "tijsverkoyen/css-to-inline-styles": "^2.4",
    "infection/infection": "^0.29"
  },
  "suggest": {
    "ext-intl": "Needed to support internationalized email addresses",
    "tijsverkoyen/css-to-inline-styles": "For automatic CSS inlining in HTML emails (Swift_Plugins_CssInlinerPlugin)"
  },
  "autoload": {
    "files": [
      "lib/swift_required.php"
    ]
  },
  "autoload-dev": {
    "psr-0": {
      "Swift_": "tests/unit"
    }
  },
  "bin": [
    "bin/swiftmailer-test"
  ],
  "extra": {
    "branch-alias": {
      "dev-master": "6.4-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "audit": {
      "abandoned": "report"
    },
    "allow-plugins": {
      "php-http/discovery": true,
      "infection/extension-installer": true,
      "tbachert/spi": true
    }
  },
  "scripts": {
    "test": "SYMFONY_DEPRECATIONS_HELPER='max[direct]=0&baselineFile=./tests/deprecation-baseline.json' vendor/bin/simple-phpunit",
    "php-cs-fixer": "php-cs-fixer --config=.php-cs-fixer.dist.php fix",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist",
    "infection:coverage": "SYMFONY_DEPRECATIONS_HELPER=disabled XDEBUG_MODE=coverage vendor/bin/phpunit --testsuite='SwiftMailer unit tests' --coverage-xml=.infection/infection/coverage-xml --log-junit=.infection/infection/junit.xml",
    "infection": [
      "@infection:coverage",
      "php -d memory_limit=1G vendor/bin/infection --threads=max --show-mutations --skip-initial-tests --coverage=.infection/infection"
    ],
    "infection:diff": [
      "@infection:coverage",
      "php -d memory_limit=1G vendor/bin/infection --threads=max --git-diff-lines --git-diff-base=master --show-mutations --min-msi=0 --skip-initial-tests --coverage=.infection/infection"
    ]
  }
}
